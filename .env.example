# Copy to .env and adjust. Never commit .env.

# Required.
DATABASE_URL=postgres://auth:auth@localhost:5433/auth

# Host port for the Postgres that docker compose starts. Only needed when
# running the service in a container; the service itself always reaches the
# database over the compose network.
POSTGRES_PORT=5433

# Host port mapped to the service, which always listens on 8080 inside the
# container. Only relevant when running through docker compose.
AUTH_PORT=8080

# Where the process listens.
BIND_ADDR=0.0.0.0:8080
DATABASE_MAX_CONNECTIONS=10

# RS256 signing keys. Generated on first run if the files are missing, but
# mount persistent storage in production or a restart invalidates every token.
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ISSUER=auth-service
JWT_AUDIENCE=auth-service-clients

# Token lifetimes, in seconds. The refresh token must outlive the access token.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Failed auth attempts allowed per client IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=10

# Comma-separated browser origins. Empty means no CORS headers at all.
CORS_ALLOWED_ORIGINS=

# Addresses that receive the admin role when they register. The admin panel is
# unreachable until someone holds that role, so this is how the first admin
# gets in. Remove it once they exist.
ADMIN_BOOTSTRAP_EMAILS=

# Set to false if migrations are applied out of band.
RUN_MIGRATIONS=true

# Tracing. LOG_FORMAT=json switches to machine-readable output.
RUST_LOG=auth_service=info,tower_http=info
LOG_FORMAT=
