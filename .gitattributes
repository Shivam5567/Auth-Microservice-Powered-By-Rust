# Normalize line endings to LF in the repository and on checkout, so that
# Windows and Linux contributors produce identical diffs.
* text=auto eol=lf

# These must keep their native encoding semantics.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
*.pem text eol=lf
